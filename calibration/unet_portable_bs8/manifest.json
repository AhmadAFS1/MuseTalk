 "purpose": "Tracked, GPU-independent validation corpus for per-GPU UNet engines (unet_ts .ts and unet_stagewise plans). scripts/unet_engine_store.py validates every engine it builds, adopts or restores against these 16 bs8 captures (gate mae_max <= 0.01, max_abs_max <= 0.5).",
 "source_corpus": "calibration/unet_multi_avatar_20260928 (gitignored, this box only)",
 "source_manifest_sha256": "6081b6987387d42a264ad3ec4ff8fa81ac4ea8cb5c3b32823a3c2f718cd02290",
 "source_builder": "scripts/build_unet_multi_avatar_corpus.py",
 "capture_format": "HLSGPUStreamScheduler._capture_unet_calibration_batch schema_version=1 (kind=unet_io_batch)",
 "capture_keys": [
  "schema_version",
  "kind=unet_io_batch",
  "sequence",
  "actual_batch",
  "padded_batch",
  "latent_batch [8,8,32,32] fp16",

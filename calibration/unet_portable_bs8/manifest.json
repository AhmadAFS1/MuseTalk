  "items"
 ],
 "reference_backend": "PyTorch FP16 eager UNet (models/musetalkV15/unet.pth), tf32+cudnn.benchmark on, inference_mode",
 "reference_host": {
  "gpu": "NVIDIA GeForce RTX 4070 SUPER",
  "torch": "2.5.1+cu121"
 },
 "batch": 8,
 "gate": {
  "fail_mae": 0.01,
  "fail_max_abs": 0.5,
  "limit": 16,
  "padded_batch_size": 8
 },
 "selection": "16 of 448: one capture per avatar (11 main + 3 holdout = 14 avatars), audio alternating across avatars so all 3 sources appear, batch positions spread over the 16-batch window (one at the utterance start), plus 2 extra: a second audio for an H3 chin avatar and the long C_repo_eng clip for a holdout avatar. Files keep their source names (unique across main/holdout) so the bs8 filename filter and sorted grouping (--group-captures 2 -> bs16) work.",
 "cross_gpu_note": "References are PyTorch FP16 eager on an RTX 4070 SUPER. Eager-vs-eager across GPUs/kernels differs by ~3e-4 MAE (source manifest checks.legacy_same_avatar_captures), far below the 0.01 gate; the shipping sm89 .ts measured mae_max 0.0026 on the full corpus.",
 "usage": {
  "unet_ts": "validate_unet_backend.py --backend trt --trt-path <ts> --capture-dir calibration/unet_portable_bs8 --padded-batch-size 8 --limit 16 --fail-mae 0.01 --fail-max-abs 0.5",
  "unet_stagewise": "MUSETALK_UNET_BACKEND=trt_stagewise MUSETALK_UNET_STAGEWISE_CACHE_DIR=<root> MUSETALK_UNET_STAGEWISE_BATCH=16 validate_unet_backend.py --backend runtime --capture-dir calibration/unet_portable_bs8 --padded-batch-size 8 --group-captures 2 --limit 16 --fail-mae 0.01 --fail-max-abs 0.5",
  "check": "scripts/unet_engine_store.py check-corpus (sha256 + pickle-key check, CPU only, no torch)"
 },

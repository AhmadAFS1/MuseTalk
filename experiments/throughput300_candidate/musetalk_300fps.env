# 300 fps candidate overlay (docs/musetalk_4070s_300fps_plan_2026-09-27.md, section 4 "Flags").
#
# Sourced by experiments/throughput300_candidate/run_candidate_api.sh AFTER the
# generated .runtime/musetalk_trt_local_sm89.env. One lever per line: rolling a
# lever back = deleting the line (or flipping it to its default in the comment).
# Every flag's unset default reproduces today's server exactly.
#
# Kept here, not in .runtime/: .runtime in this worktree is a symlink into the
# user's main checkout (/workspace/MuseTalk/.runtime), which must not be edited.
# Other plan areas (scheduler, UNet, TAESD, memory) append their own lines below
# their own header.

# ---------------------------------------------------------------- WebRTC / API (items 0.4, 0.5, 1.5, 1.7, 1.8, 1.11)
# Observational: monotonic per-track counters + server send-stamp ring for load_test_webrtc_v2.py (default 0).
WEBRTC_LIFETIME_COUNTERS=1
# 0.5: POST /webrtc/tts/kokoro -> 503; load tests use pre-synthesized WAVs (default 0).
MUSETALK_DISABLE_LOCAL_TTS=1
# 0.4: /webrtc/groups/create and /hls/groups/create accept up to 20 streams (default 12).
WEBRTC_GROUP_MAX_COUNT=20
# 1.5 (E0): scheduler thread no longer blocks on the event loop per batch (default 0).
WEBRTC_NONBLOCKING_HANDOFF=1
# 1.5 (E0): exact PyAV BGR->yuv420p on 2 converter threads instead of the event loop (default 0).
WEBRTC_HANDOFF_CONVERT_THREADS=2
# 1.7 (E0): idle/pose clips decoded once per process into a shared yuv420p cache (default 0).
WEBRTC_IDLE_FRAME_CACHE=1
# 1.7: LRU budget across avatars; 157 MiB per 240-frame 512x896 clip (default 1024).
WEBRTC_IDLE_FRAME_CACHE_MAX_MB=1024
# 1.11 (E0): idle decoders 1 thread, torch intra-op <= 4, per-turn ffmpeg on its own executor (default 0).
MUSETALK_THREAD_CAPS=1
# Timing only (same frames): deadline pacing for non-motion tracks; today's recv() re-anchors on
# every wake-up, measured 51.1-51.2 ms average send interval (19.5 fps) on CPU (default 0).
WEBRTC_DEADLINE_PACING=1

# 1.8 encoder. NOT exact: it changes the delivered bitstream (decision D5).
# G-ENC CPU measurement at a 2.5 Mbps target on real avatar frames
# (docs/fps_comparisons/4070s_300fps_impl_20260928/webrtc/test_encoder_quality.json):
#   today (H.264 aiortc libx264 medium, auto threads): 45.36 dB PSNR-YUV, 18.5 CPU-ms/frame, 1.65 Mbps achieved
#   native VP8 threads=1 (lines below):                  43.21 dB (-2.15 dB), 4.6 CPU-ms/frame, 2.49 Mbps
#   H.264 x264tuned faster 1 thread (alternative):       45.28 dB (-0.08 dB), 8.8 CPU-ms/frame
# Native VP8 passes G-ENC against stock VP8 (+0.03 dB), but is 2.15 dB below the H.264 that
# H.264-capable browsers receive today. Judge it on video before adopting (D5).
WEBRTC_VP8_ENCODER=native
WEBRTC_NATIVE_VP8_THREADS=1
# D5 tested rate; the upstream native ceiling is 1.5 Mbps.
WEBRTC_NATIVE_VP8_MAX_BITRATE_BPS=2500000
# Alternative within G-ENC: delete the three VP8 lines above and uncomment these three
# (H.264 is then negotiated for H.264-capable clients, as today, with a cheaper x264).
#WEBRTC_H264_IMPL=x264tuned
#WEBRTC_H264_X264_PRESET=faster
#WEBRTC_H264_X264_THREADS=1

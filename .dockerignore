# Default-deny. The release build also requires context.py's tracked-file audit.
**
!LICENSE
!api_server.py
!download_weights.sh
!musetalk/
!musetalk/**
!templates/
!templates/*.py
!scripts/
!scripts/*.py
!scripts/*.sh
!scripts/lib/
!scripts/lib/*.sh
!scripts/native_vp8_manifest.json
!scripts/native_vp8_licenses/
!scripts/native_vp8_licenses/**
!requirements/
!requirements/*.in
!requirements/constraints-cu121.txt
!requirements/constraints-chin-tools.txt
!configs/
!configs/recipes/
!configs/recipes/*.env
!configs/trt_bundles/
!configs/trt_bundles/*.json
!docker/
!docker/musetalk/
!docker/musetalk/**
# Re-exclude credentials and generated files even under an allowed directory.
**/.env*
**/.runtime/**
**/__pycache__/**
**/*.pyc
**/*.pem
**/*.key
**/.ssh/**
**/.aws/**
**/.git/**
docker/musetalk/__pycache__/**
docker/musetalk/tests/**

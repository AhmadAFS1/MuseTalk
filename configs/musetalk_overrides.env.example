# MuseTalk operator overrides (layer 2 of the launch chain; docs/STARTUP.md).
#
# Copy to .runtime/musetalk_overrides.env (the default; gitignored) or point
# MUSETALK_ENV_OVERRIDES_FILE at one or more files (colon-separated, earlier files win).
#
#   caller env  >  overrides files  >  .runtime/musetalk_resolved.env  >  code defaults
#
# Rules: one lever per line, KEY=VALUE or export KEY=VALUE. The file is PARSED, never sourced:
# no $expansion, no backticks, no shell metacharacters outside 'single quotes'. An inline
# "  # comment" after whitespace is allowed. A key is used only if the caller did not set it.
# Uncomment a line to use it; delete it to roll back (every default below = today's behaviour).
# Secrets do not belong here (they come from the AWS secret bootstrap / TURN env file).
#
# Legend: "# default X; <effect>". "(fast300)" marks a lever of configs/recipes/fast300.env.
# Levers from the 300 fps branch are pass-through: the launcher never changes them, it only
# validates values the server would reject and reports each lever's value + source layer
# (run_musetalk_server.sh --print-env, .runtime/musetalk_launch_<port>.json).

# ============================================================================ recipe / launch
#MUSETALK_RECIPE=fast300                  # default fast; fast300 = fast + gated 300 fps levers; legacy_int8 = old INT8 chain (rollback)
#MUSETALK_UNET_MODE=eager                 # default auto (TRT .ts iff a validated engine for this GPU); trt = hard error without one
#MUSETALK_TRT_UNET_MIN_VRAM_GB=8          # default 8; auto mode needs this much VRAM for the TRT UNet
#MUSETALK_TRT_UNET_MIN_MEM_AVAILABLE_GB=10  # default 10; auto mode needs this much MemAvailable (the .ts load spikes RSS ~8.4 GB)
#HLS_SCHEDULER_FIXED_BATCH_SIZES=16       # default 8; the resolver couples TAESD/stagewise warmup, max batch and startup slice to it
#MUSETALK_VERIFY_RECIPE=warn              # default strict; after /health a backend mismatch stops the server (warn = log only, off = skip)
#MUSETALK_VP8_FALLBACK=1                  # default 0; native VP8 preflight failure -> pyav with a warning instead of refusing to start
#MUSETALK_ALLOW_NO_GPU=1                  # default 0; let the resolver emit an env on a GPU-less host (tests / image builds)
#MUSETALK_UNET_ENGINE_PROVISION=adopt     # default auto (adopt -> restore -> build); adopt|restore|build|off, run by vast_onstart.sh
#MUSETALK_TAESD_TRT_PROVISION=auto        # default auto; TAESD TRT engine provisioning for recipe fast300 (~15 s build)
#MUSETALK_UNET_STAGEWISE_PROVISION=adopt  # default auto; stagewise UNet provisioning for recipe fast300 (bs16 build ~9 min, several GB RAM)
#MUSETALK_UNET_ENGINE_STORE=/workspace/engines/unet  # default models/tensorrt_unet; torch_tensorrt .ts engine store root
#MUSETALK_UNET_ENGINE_REMOTE=file:///workspace/engine-share  # default s3://$TRT_ARTIFACT_S3_BUCKET/trt-artifacts/unet-engines when that bucket is set
#MUSETALK_UNET_ENGINE_PUBLISH=1           # default 0; upload freshly built+validated engines to the remote (never implicit)
#MUSETALK_UNET_BUILD_MIN_MEM_AVAILABLE_GB=16  # default 14; engine builds refuse to start below this MemAvailable
#MUSETALK_TRT_FALLBACK=1                  # default 0 in the fast recipes; 1 = a failed TAESD/TRT load silently serves a slower backend
#MUSETALK_TAESD_COMPILE=0                 # default 1; 0 = eager TAESD (~12.4 vs 6.8 ms per bs8), used when torch.compile is broken here
#MUSETALK_TAESD_COMPILE_MODE=reduce-overhead  # default max-autotune; compile mode of the compiled TAESD
#AVATAR_CACHE_MAX_MEMORY_MB=8192          # default clamp(20% of host RAM, 2048, 16384); avatar cache budget in HOST RAM
#HLS_MAX_PENDING_JOBS=32                  # default 24; admission cap on queued + preparing HLS/WebRTC jobs
#TORCHINDUCTOR_CACHE_DIR=/workspace/.cache/torchinductor  # default /tmp/torchinductor_<user>; persist compiled-TAESD kernels across reboots
#HF_HUB_OFFLINE=1                         # default unset; only after install downloaded every weight (TAESD included)
#MUSETALK_CHIN_TRACKER_PYTHON=/workspace/.venvs/musetalk_chin_tools/bin/python  # default: emitted by the resolver when install --with-chin-tools ran

# ============================================================================ engines
#MUSETALK_TAESD_BACKEND=trt               # default compiled; (fast300) TensorRT FP16 TAESD + fused uint8 BGR post, engines in models/taesd/trt
#MUSETALK_TAESD_TRT_DIR=models/taesd/trt  # default models/taesd/trt; TAESD TRT engine directory (keyed by TRT version, GPU, ONNX hash)
#MUSETALK_TAESD_TRT_BATCH=8               # default 8; static engine batch, larger inputs run as sub-batches (part of the key)
#MUSETALK_TAESD_TRT_BUILD=0               # default 1 (build on first use inside startup); (fast300) 0 = refuse, engines come from the store
#MUSETALK_TAESD_TRT_STRICT=1              # default 0 (fall back to compiled TAESD with a warning); (fast300) 1 = fail startup
#MUSETALK_TAESD_TRT_FUSED_POST=0          # default 1; 0 = engine fp16 output + the repo torch postprocess
#MUSETALK_TAESD_TRT_OPT_LEVEL=5           # default 3; builder optimisation level (part of the key)
#MUSETALK_TAESD_TRT_STRONGLY_TYPED=1      # default 0; strongly typed network (part of the key)
#MUSETALK_UNET_BACKEND=trt_stagewise      # default: the resolver picks trt (.ts) or eager; (fast300) 11-block ONNX-parser FP16 UNet + one CUDA graph
#MUSETALK_UNET_STAGEWISE_BATCH=16         # default 16; stagewise engine batch (smaller batches are padded, larger split); match the buckets
#MUSETALK_UNET_STAGEWISE_CACHE_DIR=models/tensorrt_unet_stagewise_sm89  # default: the resolver points it at the validated set for this GPU
#MUSETALK_UNET_STAGEWISE_CUDAGRAPH=0      # default 1; 0 = enqueue the 11 contexts without the captured graph
#MUSETALK_UNET_STAGEWISE_PROBE_CHECK=0    # default 1; startup probe batch compared with the manifest hash
#MUSETALK_UNET_STAGEWISE_PROBE_TOL=0.001  # default 0 (exact SHA); tolerance when a driver change moves the probe output
#MUSETALK_UNET_STAGEWISE_VERIFY_SHA=0     # default 1; verify every plan's SHA-256 against the manifest at load
#MUSETALK_TRT_UNET_CUDAGRAPHS=manual      # default 0; (fast300) CUDA-graph the .ts UNet call (manual|runtime|0; invalid values fail startup)
#MUSETALK_FREE_EAGER_UNET=1               # default 0; (fast300) drop the eager FP16 UNet (~1.7 GB VRAM) once a TRT UNet is active

# ============================================================================ serving
#WEBRTC_NONBLOCKING_HANDOFF=1             # default 0; (fast300) scheduler thread hands composed batches to a per-track FIFO and returns at once
#WEBRTC_HANDOFF_MAX_PENDING_FRAMES=64     # default 64; bound of that FIFO per track (0 = the track's max_queue)
#WEBRTC_HANDOFF_CONVERT_THREADS=2         # default 0; >0 = BGR->yuv420p on N shared threads instead of the event loop
#WEBRTC_YUV_IN_COMPOSE=1                  # default 0; compose workers attach the exact PyAV yuv420p conversion to each WebRTC frame
#WEBRTC_IDLE_FRAME_CACHE=1                # default 0; (fast300) decode each idle/pose clip once per process into a shared yuv420p cache
#WEBRTC_IDLE_FRAME_CACHE_MAX_MB=1024      # default 1024; LRU budget of the idle frame cache
#WEBRTC_IDLE_FRAME_CACHE_DECODE_THREADS=4  # default 4; FFmpeg threads for the one-time clip decode
#WEBRTC_IDLE_FRAME_CACHE_WORKERS=2        # default 2; background threads building cache entries
#HLS_GPU_PIPELINE_DEPTH=2                 # default 1; (fast300) double-buffered GPU loop: launch batch N+1 before collecting N
#HLS_GPU_OUTPUT_RING=0                    # default 0 (= depth + 2); pinned output slots per shape for depth >= 2
#HLS_GPU_BLOCKING_WAIT=1                  # default 0; depth >= 2: the collect wait sleeps instead of spinning
#HLS_SCHEDULER_POLICY=edf                 # default roundrobin; (fast300) earliest-deadline-first with a run-ahead cap (invalid values fail startup)
#HLS_SCHEDULER_MAX_RUNAHEAD_S=5           # default 5; edf: jobs further ahead of playout than this wait (<=0 off)
#HLS_SCHEDULER_EDF_STARTUP_FRAMES=0       # default 0 (= prebuffer x fps); edf first-slice size per job
#HLS_SCHEDULER_EDF_URGENT_S=0.5           # default 0.5; edf: warmed jobs with less slack are served before startup jobs
#HLS_SCHEDULER_EDF_MAX_QUEUE_FRAMES=0     # default 0 (= the track's max_queue); edf queue-full skip threshold
#HLS_SKIP_GPU_FOR_RAW=1                   # default 0; (fast300) frames whose face is discarded skip UNet/TAESD and compose from the raw layer
#HLS_SKIP_RAW_MAX_PENDING_BATCHES=2       # default 2; pacing of all-raw jobs with HLS_SKIP_GPU_FOR_RAW=1
#HLS_SKIP_CROSSFADE_COPY=1                # default 0; the WebRTC crossfade history copies only the last frame of a batch
#MUSETALK_WHISPER_STREAM=1                # default 0; Whisper encode in job prep runs on its own CUDA stream
#WEBRTC_RAW_IDLE_POSE=1                   # default 0; neutral resting frames are served raw (pairs with HLS_SKIP_GPU_FOR_RAW)
#HLS_GPU_STAGE_SYNC_TIMING=0              # default 1; drop the per-stage torch.cuda.synchronize used for timing (no offline gain measured)
#MUSETALK_VAE_DECODE_TIMING_SYNC=0        # default 1; drop the synchronize around each decode used for timing
#MUSETALK_THREAD_CAPS=1                   # default 0; (fast300) idle decoders 1 thread, torch intra-op <= 4, ffmpeg on its own executor
#MUSETALK_IDLE_DECODE_THREADS=1           # default 1; idle decoder threads when MUSETALK_THREAD_CAPS=1
#MUSETALK_MOTION_DECODE_THREADS=4         # default unset (16); motion entry/return decoder threads when THREAD_CAPS=1
#MUSETALK_TORCH_INTRAOP_THREADS=4         # default 4; torch intra-op cap when THREAD_CAPS=1 (0 = leave torch alone)
#MUSETALK_CV2_THREADS=1                   # default unset; cv2.setNumThreads when THREAD_CAPS=1
#MUSETALK_FFMPEG_EXECUTOR_WORKERS=4       # default 4; per-turn ffmpeg executor size when THREAD_CAPS=1
#WEBRTC_GROUP_MAX_COUNT=20                # default 12; upper bound for count on /webrtc/groups/create and /hls/groups/create
#MUSETALK_DISABLE_LOCAL_TTS=1             # default 0; POST /webrtc/tts/kokoro returns 503 without loading Kokoro (TTS off-box)
#MALLOC_ARENA_MAX=4                       # default glibc (8 x cores); (fast300) fewer malloc arenas to keep RSS flat over long soaks

# ============================================================================ memory
#MUSETALK_AVATAR_MASK_CHANNELS=1          # default 3; (fast300) masks held as the single plane every consumer reads (bit-exact)
#MUSETALK_AVATAR_MASK_STORE=png           # default decoded; (fast300) masks held as their PNG bytes, decoded on demand
#MUSETALK_AVATAR_FRAME_STORE=png          # default decoded; (fast300) unique source frames held as PNG bytes (+LRU/readahead)
#MUSETALK_AVATAR_DECODED_LRU_FRAMES=24    # default 24; png store: decoded frames kept per avatar
#MUSETALK_AVATAR_PNG_READAHEAD=8          # default 8; png store: cycle positions decoded ahead of compose (0 = inline only)
#MUSETALK_AVATAR_PNG_DECODE_WORKERS=4     # default 4; png store: shared readahead threads
#MUSETALK_AVATAR_PLAN_FLOAT_ALPHA=0       # default 1; 0 = derive each compose plan's float32 alpha on access
#MUSETALK_AVATAR_DEDUP_CYCLE=0            # default 1; 0 = disable the bit-identical avatar cycle dedup (rollback only)

# ============================================================================ encoders
#WEBRTC_VP8_ENCODER=native                # default pyav; pinned native libvpx 1.13.1 VP8 (needs install_native_vp8.py; REJECTS H.264-only offers)
#WEBRTC_NATIVE_VP8_DIR=.runtime/native_vp8  # default <repo>/.runtime/native_vp8; native VP8 artifact directory
#WEBRTC_NATIVE_VP8_THREADS=1              # default aiortc number_of_threads(); native VP8 cfg.g_threads (1..16)
#WEBRTC_NATIVE_VP8_MAX_BITRATE_BPS=3000000  # default aiortc MAX_BITRATE; native VP8 bitrate ceiling (<= 4000000)
#WEBRTC_NATIVE_VP8_BITRATE_FLOOR_BPS=500000  # default 0; native VP8 bitrate floor
#WEBRTC_H264_IMPL=x264tuned               # default aiortc (libx264 medium); (fast300) x264tuned = libx264 preset/threads below; nvenc = h264_nvenc + fallback
#WEBRTC_H264_X264_PRESET=veryfast         # default veryfast; x264 preset for x264tuned (and the NVENC fallback)
#WEBRTC_H264_X264_THREADS=1               # default 1; x264 threads for x264tuned (and the NVENC fallback)
#WEBRTC_H264_NVENC_PRESET=p2              # default p2; NVENC preset for WEBRTC_H264_IMPL=nvenc
#WEBRTC_H264_NVENC_TUNE=ll                # default ll; NVENC tune for WEBRTC_H264_IMPL=nvenc
#WEBRTC_NVENC_MAX_SESSIONS=12             # default 12; process-wide NVENC sessions, encoders beyond it use x264tuned
#WEBRTC_H264_MAXBITRATE=6000000           # default 6000000; aiortc H.264 MAX_BITRATE

# ============================================================================ telemetry
#WEBRTC_LIFETIME_COUNTERS=1               # default 0; per-track monotonic counters (GET /webrtc/sessions/stats?view=lifetime)
#WEBRTC_LIFETIME_SEND_RING=256            # default 256; per-track send-timestamp ring size
#HLS_GPU_EVENT_TIMING=1                   # default 0; CUDA-event stage timing + capacity telemetry in the scheduler stats
#HLS_GPU_TIMING_WINDOW=512                # default 512; batches kept for the capacity telemetry window
#WEBRTC_HANDOFF_VERIFY=1                  # default 0; smoke tests only: SHA-1 every frame at submit and at push (~0.4 ms/frame)
#WEBRTC_PREENCODE_SHA_DIR=/workspace/tmp/preencode_sha  # default unset; smoke tests only: per-frame I420 SHA-256 JSON lines
#WEBRTC_H264_ENCODE_TIMING=0              # default 1; per-frame H.264 encode timing wrapper
#MUSETALK_VAE_DECODE_TIMING=0             # default 1; decode timing in the VAE wrapper
#SERVER_RESOURCE_LOG_INTERVAL=10          # default 5.0; seconds between RESOURCE log lines

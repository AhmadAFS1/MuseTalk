# MuseTalk recipe "fast300" = recipe "fast" + the 300 fps levers listed below.
#
# Opt in with MUSETALK_RECIPE=fast300 (caller env or an overrides file). It is NOT the default:
# the user approves fast300 as a whole after the labelled video review.
#
# Who reads this file: scripts/musetalk_host_profile.py resolve --recipe fast300 (the resolver).
# It is parsed, never sourced. Layering is unchanged: caller env > overrides files > the
# resolved env (which is where enabled levers land) > code defaults.
#
# Format
#   - One lever per line: KEY=VALUE, no quotes needed, no expansion, no inline comments.
#   - "#KEY=VALUE" (a '#' directly followed by the key) is a lever that is switched OFF. Enable
#     it by deleting the leading '#'. Prose comments are "# ..." (hash, space).
#   - "# @lever <group> requires=<prereq>[,<prereq>...]" starts a group; the KEY=VALUE lines
#     that follow, up to the next blank line, belong to it and are enabled or dropped together.
#   - The resolver enables a group only when every prerequisite holds on THIS host for THIS
#     engine key and records every dropped group with its reason in
#     .runtime/musetalk_resolved.json. A resolver that does not know the @lever tags still
#     works: it then treats every uncommented KEY=VALUE as one lever with its own gate table.
#
# Machine-checkable prerequisites (resolver):
#   engine:unet_stagewise  a stagewise FP16 UNet set for the group's MUSETALK_UNET_STAGEWISE_BATCH,
#                          validated for this engine key (scripts/unet_engine_store.py); the resolver
#                          points MUSETALK_UNET_STAGEWISE_CACHE_DIR at it (never a hard-coded sm89 dir)
#   engine:taesd_trt       a TAESD TRT engine validated for this key (G-TAESD recorded in its meta)
#   engine:unet_ts         the resolved UNet is the validated torch_tensorrt .ts (MUSETALK_UNET_BACKEND=trt)
#   unet:trt_any           the resolved UNet is a TensorRT backend (.ts or stagewise)
#   vp8:native_preflight   the native VP8 CPU preflight passes in this venv
#   h264:native_fallback   H.264-only clients still negotiate a working H.264 path while
#                          the native VP8 encoder is selected (NOT true in this checkout, see ENCODERS)
#   gpu:nvenc              the GPU exposes NVENC to PyAV (h264_nvenc)
#   code:<path>            <path> (repo-relative) exists and mentions the group's FIRST key,
#                          i.e. the lever is implemented in this checkout
# The human gate named on each "# gate:" line is what the orchestrator must see PASS on this box
# before it uncomments the group. Uncommenting is the orchestrator's assertion that the gate passed.
#
# STATUS 2026-09-28: every lever below is COMMENTED OUT, so fast300 currently resolves to exactly
# the fast recipe. The orchestrator enables groups one by one as their gates pass.

# ============================================================================ engines
# gate: G-UNET stagewise bs16 vs eager on the multi-avatar corpus, mae_max <= 0.01 and
#       max_abs_max <= 0.5 on main + holdout (2026-09-28 PASS: 0.00250/0.431 main,
#       0.00206/0.317 holdout), sustained bench_gpu_path >= the fast recipe, golden video review.
# Batch 16 with scheduler buckets 16: the resolver derives MUSETALK_TAESD_WARMUP_BATCHES,
# MUSETALK_TRT_STAGEWISE_WARMUP_BATCHES, HLS_SCHEDULER_MAX_BATCH=16 and the startup slice from it.
# @lever stagewise_unet requires=engine:unet_stagewise,code:scripts/unet_stagewise_trt.py
#MUSETALK_UNET_BACKEND=trt_stagewise
#MUSETALK_UNET_STAGEWISE_BATCH=16
#HLS_SCHEDULER_FIXED_BATCH_SIZES=16

# gate: G-TAESD (max <= 3 LSB, mean <= 0.2 LSB vs compiled TAESD, verdict written into the
#       engine meta), G-TRACK (chin tracker on the decoded faces), speed_taesd_trt >= compiled.
# TRT_BUILD 0: the server never builds at serve time (the engine store builds at provision time).
# TRT_STRICT 1: a load/verify failure fails startup instead of silently serving compiled TAESD.
# @lever taesd_trt requires=engine:taesd_trt,code:scripts/vae_fast_decoder.py
#MUSETALK_TAESD_BACKEND=trt
#MUSETALK_TAESD_TRT_BUILD=0
#MUSETALK_TAESD_TRT_STRICT=1

# gate: unet_fp16/stepA_cudagraph_gate (max_abs 0 vs mode 0 on the shipping .ts, UNet time <= -2%).
# Only meaningful for the .ts UNet; dropped when the stagewise group is active (it has its own graph).
# @lever ts_unet_cudagraphs requires=engine:unet_ts,code:scripts/trt_runtime.py
#MUSETALK_TRT_UNET_CUDAGRAPHS=manual

# ============================================================================ memory
# gate: measured VRAM drop with identical golden SHA; must stay 0 while capturing calibration.
# @lever free_eager_unet requires=unet:trt_any,code:scripts/avatar_manager_parallel.py
#MUSETALK_FREE_EAGER_UNET=1

# gate: avatar_memory/gate_bitexact (2026-09-28 PASS, compose output bit-identical).
# @lever avatar_mask_1ch requires=code:scripts/api_avatar.py
#MUSETALK_AVATAR_MASK_CHANNELS=1

# gate: gate_bitexact PASS + decode_cost.py (PNG decode CPU per frame fits the compose budget at
#       target streams) + a many-avatar RSS measurement.
# @lever avatar_png_store requires=code:scripts/api_avatar.py
#MUSETALK_AVATAR_FRAME_STORE=png
#MUSETALK_AVATAR_MASK_STORE=png

# ============================================================================ serving
# gate: per-stream I420 SHA identical, A/V offset unchanged, sequence numbers monotonic
#       (webrtc/test_live_handoff_fifo), then a live load run.
# @lever nonblocking_handoff requires=code:scripts/webrtc_media_flags.py
#WEBRTC_NONBLOCKING_HANDOFF=1

# gate: idle/pose frame SHAs identical, visual idle -> live -> idle check.
# @lever idle_frame_cache requires=code:scripts/webrtc_idle_frame_cache.py
#WEBRTC_IDLE_FRAME_CACHE=1

# gate: golden SHA at depth 1 vs 2 (replay_scheduler_exactness), per-stream frame order monotonic.
# @lever pipeline_depth2 requires=code:scripts/hls_gpu_scheduler.py
#HLS_GPU_PIPELINE_DEPTH=2

# gate: per-stream SHA and order; a burst at capacity + 2 holds fewer frames than roundrobin.
# @lever edf_scheduler requires=code:scripts/hls_gpu_scheduler.py
#HLS_SCHEDULER_POLICY=edf

# gate: exact_silence turn SHA identical; GPU rows freed are refilled.
# @lever skip_gpu_for_raw requires=code:scripts/hls_gpu_scheduler.py
#HLS_SKIP_GPU_FOR_RAW=1

# gate: GPU busy fraction does not drop; golden SHA.
# @lever thread_caps requires=code:scripts/webrtc_media_flags.py
#MUSETALK_THREAD_CAPS=1

# gate: soak run shows a flat RSS slope; golden SHA (plan item 1.12).
# @lever malloc_arena
#MALLOC_ARENA_MAX=4

# ============================================================================ encoders
# The default media path negotiates H.264 (api_server.prefer_h264), so the H.264 encoder is the
# lever that matters for CPU at 300 fps.
# gate: G-ENC (receiver recording; PSNR decoded vs pre-encode within 0.2 dB of aiortc libx264).
# @lever h264_x264tuned requires=code:scripts/webrtc_h264_override.py
#WEBRTC_H264_IMPL=x264tuned

# DECISION 2026-09-28: WEBRTC_VP8_ENCODER stays pyav in fast300. Native VP8 needs
#   (i) the native VP8 preflight and (ii) a working H.264 path for H.264-only clients.
#   (ii) fails in this checkout: api_server.webrtc_offer calls validate_native_offer, which
#   raises "H264-only offers are unsupported" (HTTP 400) whenever WEBRTC_VP8_ENCODER=native,
#   and it also skips prefer_h264 for every session. Re-evaluate when native mode keeps an
#   H.264 path; until then the h264:native_fallback prerequisite can never hold.
# @lever native_vp8 requires=vp8:native_preflight,h264:native_fallback,code:scripts/webrtc_native_vp8.py
#WEBRTC_VP8_ENCODER=native
#WEBRTC_NATIVE_VP8_THREADS=1

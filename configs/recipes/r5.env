# MuseTalk recipe "r5" = recipe "fast" + the ~400 fps engines of one RTX 4070 SUPER + the serving
# levers of the 2026-09-29 live WebRTC test (docs/fps_comparisons/live15_r5_20260929/README.md:
# 10 calls per worker pass with margin, 15 is at the knee; the final configuration was
# experiments/live15_r5/{loopfix,serve,common}.env, whose test-rig lines are left out here).
#
# Opt in with MUSETALK_RECIPE=r5 (caller env, Vast template env or an overrides file). On a fresh
# instance scripts/vast_onstart.sh then restores the pinned engine bundle from S3 before the server
# starts (configs/trt_bundles/rtx4070super-r5-srcg50-int8.json).
#
# Same format and rules as configs/recipes/fast300.env (read that header): parsed, never sourced;
# "#KEY=VALUE" is a switched-off lever; "# @lever <group> requires=<p>,..." starts a group that runs
# to the next blank line and is enabled or dropped whole. Layering: caller env > overrides files >
# this file > resolver values > code defaults.
#
# Extra prerequisite used here:
#   bundle:<name>   configs/trt_bundles/<name>.json is for this host's exact engine key (GPU model
#                   + compute capability + TensorRT), its restore stamp in the bundle's sidecar_dir
#                   binds the stored manifest to the pinned archive SHA256, and every file of that
#                   manifest is present with its recorded size. The resolver then points
#                   MUSETALK_UNET_STAGEWISE_CACHE_DIR and MUSETALK_TAESD_TRT_DIR at the bundle.
#
# Not in this file on purpose:
#  - computed per host by the resolver: HLS_SCHEDULER_MAX_BATCH, HLS_SCHEDULER_STARTUP_SLICE_SIZE,
#    MUSETALK_TAESD_WARMUP_BATCHES, MUSETALK_TRT_STAGEWISE_WARMUP_BATCHES (16/8/16/16 from the
#    buckets), MUSETALK_TRT_FALLBACK (always 0), MUSETALK_UNET_STAGEWISE_CACHE_DIR and
#    MUSETALK_TAESD_TRT_DIR/_BATCH (pointed at the bundle; never pin them here),
#    HLS_MAX_PENDING_JOBS (24), AVATAR_CACHE_MAX_MEMORY_MB (20% of host RAM, 2-16 GB; 15 lean avatars
#    need about 2.6 GB), AVATAR_CACHE_TTL_SECONDS (3600 s idle), worker counts;
#  - test rig only: AVATAR_S3_ENABLED=0, HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1,
#    LINGUA_DRAIN_TIMEOUT_SECONDS=30, AVATAR_CACHE_TTL_SECONDS=14400, AVATAR_CACHE_MAX_MEMORY_MB=9000,
#    WEBRTC_GROUP_MAX_COUNT=15 (demo wall);
#  - owned by the control-plane env: LINGUA_WORKER_DEFAULT_CAPACITY (calls advertised per worker).

# ============================================================================ engines
# r5 = layer-selective INT8 stagewise UNet srcg50 (gmac_0.50 blocks) bs16 + TensorRT TAESD bs8
# (runtime key 6111388248264a4ef2ae): raw TensorRT plans for exactly NVIDIA GeForce RTX 4070 SUPER,
# sm_89, TensorRT 10.3.0. On any other GPU (another sm_89 card included), or when the bundle is not
# restored, this group is dropped with its reason in .runtime/musetalk_resolved.json and the host
# serves the fast engines plus the serving groups below.
# gate: accepted as a whole on the labelled video review (docs/fps_comparisons/4070s_400fps). The
#   numeric gates are mixed: repo UNet gate mae 0.00444/0.00392 (<= 0.01) but max_abs 0.78/1.26
#   (engine-store bar 0.5); the TAESD meta records G-TAESD FAIL (full max 5 LSB, bar 3). That is
#   why these engines come from the pinned bundle and not from the engine store.
# BUILD 0: the server never builds. STRICT 1: a TAESD load/verify failure stops startup instead of
#   serving compiled TAESD. The server also checks each UNet plan's SHA-256 and the probe output
#   against the set's manifest (MUSETALK_UNET_STAGEWISE_VERIFY_SHA/_PROBE_CHECK, default 1).
# HLS_SCHEDULER_FIXED_BATCH_SIZES pins the tested scheduler shape 16/[16].
# @lever r5_engines requires=bundle:rtx4070super-r5-srcg50-int8,code:scripts/unet_stagewise_trt.py
MUSETALK_UNET_BACKEND=trt_stagewise
MUSETALK_UNET_STAGEWISE_BATCH=16
HLS_SCHEDULER_FIXED_BATCH_SIZES=16
MUSETALK_TAESD_BACKEND=trt
MUSETALK_TAESD_TRT_BUILD=0
MUSETALK_TAESD_TRT_STRICT=1

# ============================================================================ serving
# Every lever below keeps every output frame identical; rollback is deleting the line (or
# commenting it out). These groups do not depend on the engines.

# Pacing deadline advances one frame time per frame: asyncio oversleep no longer stretches the
# average send interval (~51 ms measured).
# @lever r5_deadline_pacing requires=code:scripts/webrtc_media_flags.py
WEBRTC_DEADLINE_PACING=1

# The scheduler thread hands composed batches to a per-track FIFO and returns; BGR->yuv420p runs on
# 2 shared converter threads; the FIFO holds packed I420 arrays, so no av.VideoFrame reference cycle
# reaches GC generation 2 (live README 4.6). Needs WEBRTC_BATCH_FRAME_CALLBACK=1 (the resolver emits it).
# @lever r5_handoff requires=code:scripts/webrtc_media_flags.py
WEBRTC_NONBLOCKING_HANDOFF=1
WEBRTC_HANDOFF_CONVERT_THREADS=2
WEBRTC_QUEUE_PACKED_I420=1

# Idle/pose clips are decoded once per process; POST /avatars/{id}/cache/warm also builds them (warm
# before routing a call). MAX_MB is an LRU cap in MiB, not a reservation: size it to the clips of every
# avatar a worker keeps warm (frames x W x H x 1.5 bytes; a 240-frame 512x896 clip is 157.5 MiB; the 15
# test avatars, idle clip only, took 2169 MiB). A clip that does not fit is decoded per session on the
# event loop (live README 4.4).
# @lever r5_idle_frame_cache requires=code:scripts/webrtc_idle_frame_cache.py
WEBRTC_IDLE_FRAME_CACHE=1
WEBRTC_IDLE_FRAME_CACHE_WARM=1
WEBRTC_IDLE_FRAME_CACHE_MAX_MB=2400

# gc.collect() + gc.freeze() after startup and after each avatar load; full collections 10x rarer
# (live README 4.1, 4.7). Caveat: an evicted frozen avatar keeps its reference cycles (never measured;
# the test evicted none).
# @lever r5_gc requires=code:scripts/gc_tuning.py
MUSETALK_GC_FREEZE=1
MUSETALK_GC_THRESHOLDS=700,10,100

# nvidia-smi turn snapshot, GET /stats, /health, /worker/state built on a worker thread (live README
# 4.2); not a diagnostic despite the name.
# @lever r5_offloop requires=code:scripts/webrtc_media_flags.py
MUSETALK_OFFLOOP_DIAGNOSTICS=1

# Idle decoders 1 FFmpeg thread instead of 16, torch intra-op <= 4, per-turn ffmpeg on its own
# 4-worker executor.
# @lever r5_thread_caps requires=code:scripts/webrtc_media_flags.py
MUSETALK_THREAD_CAPS=1

# Crossfade history copies only a batch's last frame; no timing-only torch.cuda.synchronize after
# H2D/UNet or after each decode.
# @lever r5_scheduler requires=code:scripts/hls_gpu_scheduler.py
HLS_SKIP_CROSSFADE_COPY=1
HLS_GPU_STAGE_SYNC_TIMING=0
MUSETALK_VAE_DECODE_TIMING_SYNC=0

# ============================================================================ memory
# Lean avatar layout, bit-exact: 1-plane masks; masks and unique frames held as PNG bytes (decoded on
# demand, 24-frame LRU, 8 readahead); compose-plan float alpha derived on access. About 172 MB per
# avatar in the cache (106-206 MB over the 15 test avatars).
# @lever r5_avatar_layout requires=code:scripts/api_avatar.py
MUSETALK_AVATAR_MASK_CHANNELS=1
MUSETALK_AVATAR_MASK_STORE=png
MUSETALK_AVATAR_FRAME_STORE=png
MUSETALK_AVATAR_PLAN_FLOAT_ALPHA=0

# ============================================================================ TTS (off)
# The live test ran with local Kokoro disabled (POST /webrtc/tts/kokoro returns 503); local Kokoro
# would take 30-85% of the CPU at 10-15 calls. Left off here because it removes an endpoint:
# enable it once production TTS is known to run elsewhere.
# @lever r5_no_local_tts requires=code:scripts/webrtc_media_flags.py
#MUSETALK_DISABLE_LOCAL_TTS=1

# ============================================================================ telemetry (off)
# Both were on in every live run (the rig scored pass/fail from the send ring and sampled /stats
# capacity). Frame-neutral and cheap; enable only if something polls them, and poll
# /webrtc/sessions/stats?view=lifetime sparingly: replies are built on the event loop (live README 4.5).
# @lever r5_telemetry requires=code:scripts/webrtc_media_flags.py
#WEBRTC_LIFETIME_COUNTERS=1
#HLS_GPU_EVENT_TIMING=1

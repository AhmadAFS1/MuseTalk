# charfactory (EC2-side orchestrator) configuration. Copy to /etc/charfactory.env and `set -a; . /etc/charfactory.env; set +a`.
VAST_API_KEY=                                   # or ~/.config/vastai/vast_api_key
CHARFACTORY_TEMPLATE_HASH=                      # hash of the Vast template built from orchestrator/template/ (see template/README.md)
CHARFACTORY_WORKER_TOKEN=                       # must equal CHARACTER_WORKER_TOKEN in the template env / runtime secret
CHARFACTORY_API_TOKEN=                          # bearer token the Lingua backend uses against `charfactory.py serve`
CHARFACTORY_RESULT_WEBHOOK=                     # optional: POST {"event":"character.job","job":{...}} here when a job finishes
CHARFACTORY_RESULT_WEBHOOK_TOKEN=
CHARFACTORY_MAX_WORKERS=2                       # concurrent Vast instances; one job runs per instance at a time
CHARFACTORY_MAX_DPH=1.5                         # highest on-demand price accepted, $/hour
CHARFACTORY_DISK_GB=200                         # 61 GB H3 weights + two venvs + working space
CHARFACTORY_IDLE_TTL_S=900                      # destroy a ready worker idle this long when the queue is empty
CHARFACTORY_READY_TIMEOUT_S=3600                # fresh install budget before a worker counts as failed
CHARFACTORY_JOB_TIMEOUT_S=10800                 # one character (3 H3 poses + QC reroll + prepare) must finish within this
CHARFACTORY_MAX_WORKER_LIFETIME_S=43200
CHARFACTORY_POLL_INTERVAL_S=20
CHARFACTORY_DATA_DIR=~/.charfactory             # sqlite db + stored portraits
# Offer query (Vast CLI syntax). Ada GPUs with >= 12 GB, >= 30 GB host RAM, cu130-capable driver:
# CHARFACTORY_OFFER_QUERY=num_gpus=1 gpu_ram>=12 cpu_ram>=30 disk_space>=200 driver_version>=580.65.6 cuda_vers>=13.0 inet_down>=500 reliability>0.98 compute_cap>=890 compute_cap<1000 rented=False

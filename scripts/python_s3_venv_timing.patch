+  log "server pip:$(printf ' %q' "${PIP_INSTALL_ARGS[@]}")"
+  run_strict_step "Install server packages (server.in$(flag_on "$LEGACY_INT8" && echo ' + legacy-int8.in'))" pip_install_groups_step
+  if flag_on "$KOKORO"; then

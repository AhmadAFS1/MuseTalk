+    printf 'PIP_KOKORO_COMMAND=%s -m pip' "$VENV_PY"
+    printf ' %q' "${PIP_KOKORO_ARGS[@]}"
+    printf '\n'
+  else
+    printf 'PIP_KOKORO_COMMAND=disabled\n'
+  fi
 }
 
 if [[ -z "$HOST_PY" ]]; then
@@ -653,6 +670,10 @@ pip_install_groups_step() {
